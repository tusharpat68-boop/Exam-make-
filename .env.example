PORT=3000
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
ALLOWED_ORIGIN=http://localhost:3000
# Firebase Admin: paste the service-account JSON on ONE line
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project"}
# Comma-separated UIDs allowed to use admin APIs (checked server-side)
ADMIN_UIDS=
# Python math service (same MATH_SERVICE_TOKEN value is used by both Node and Python)
MATH_SERVICE_URL=http://127.0.0.1:5001
MATH_SERVICE_TOKEN=change-me-to-a-long-random-string
MATH_PORT=5001
MATH_TIMEOUT=8
